# Netlify. The service worker, the manifest and the course database must always be revalidated;
# the hashed files in /assets never change, so they can be cached for a year.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/content.sqlite
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
